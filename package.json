{
  "name": "nebula-tech-language-lab",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "lint": "oxlint app lib mobile scripts vite.config.ts vite.mobile.config.ts next.config.ts capacitor.config.ts",
    "format": "oxfmt",
    "content:import": "node scripts/import-content.mjs",
    "media:optimize": "node scripts/optimize-media.mjs",
    "content:analyze": "node scripts/analyze-content.mjs",
    "pages:build": "node scripts/build-github-pages.mjs",
    "pages:serve": "node scripts/serve-pages.mjs",
    "test": "node --test tests/lesson.test.mjs tests/api.test.mjs tests/client.test.mjs tests/content.test.mjs",
    "mobile:build": "node scripts/build-mobile.mjs",
    "android:open": "cap open android",
    "android:apk": "node scripts/android-apk.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm test",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "sharp": "0.34.5",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
